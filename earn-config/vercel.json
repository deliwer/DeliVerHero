{
  "name": "deliwer-earn-portal",

  "rewrites": [
    {
      "source": "/",
      "destination": "https://deliwer.com/earn"
    },
    {
      "source": "/(.*)",
      "destination": "https://deliwer.com/$1"
    }
  ],

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
