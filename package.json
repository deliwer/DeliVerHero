  "scripts": {
    "dev": "NODE_ENV=development tsx server/index.ts",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "build:subpath": "VITE_BASE_PATH=/pakistan-mission vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "db:push": "drizzle-kit push",
    "db:push:deploy": "drizzle-kit push --force",
    "predeploy": "npm run build && npm run db:push:deploy",
    "deploy": "echo 'dist/ rebuilt and schema pushed. Commit your changes and click Deploy in Replit.'"
  },
