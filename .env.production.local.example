# Example environment variables for production subpath deployment
# Copy this to .env.production.local and update values

# Base path for subpath deployment (e.g., /pakistan-mission)
VITE_BASE_PATH=/pakistan-mission

# Public URL for absolute asset paths (optional)
# PUBLIC_URL=https://www.deliwer.com/pakistan-mission

# Backend API URL if different from frontend
# VITE_API_URL=https://api.deliwer.com
